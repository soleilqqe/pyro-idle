    <style>
        :root {
            --coin-tilt-x: 0deg;
            --coin-tilt-y: 0deg;
            --coin-scale: 1;
        }

        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
            user-select: none;
            -webkit-user-select: none;
            -webkit-touch-callout: none;
        }

        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #08080a;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            color: #ffffff;
            touch-action: none;
        }

        /* Fixed neutral dark ambient background - NEVER changes color */
        .ambient-bg {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 0;
            background: radial-gradient(circle at 50% 56%, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.01) 42%, transparent 72%);
        }

        .ambient-pulse {
            position: fixed;
            top: 56%;
            left: 50%;
            width: 340px;
            height: 340px;
            margin-left: -170px;
            margin-top: -170px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.09) 0%, transparent 70%);
            filter: blur(42px);
            opacity: 0.35;
            transform: scale(0.95);
            transition: transform 0.15s ease-out, opacity 0.2s ease-out;
            pointer-events: none;
            z-index: 0;
        }

        /* Minimalist Dark Glass Pill */
        .liquid-glass {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.02) 100%);
            backdrop-filter: blur(20px) saturate(140%);
            -webkit-backdrop-filter: blur(20px) saturate(140%);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 
                0 10px 30px -10px rgba(0, 0, 0, 0.85),
                inset 0 1px 1px 0 rgba(255, 255, 255, 0.12);
        }

        .liquid-glass-btn {
            transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.2s ease;
        }
        .liquid-glass-btn:active {
            transform: scale(0.9);
            background: rgba(255, 255, 255, 0.1);
        }

        /* Score Typography */
        .score-text {
            font-variant-numeric: tabular-nums;
            letter-spacing: -0.04em;
            background: linear-gradient(180deg, #FFFFFF 15%, rgba(255, 255, 255, 0.5) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.8));
            transition: transform 0.09s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .score-bump {
            transform: scale(1.045);
        }

        /* 3D Coin Stage */
        .coin-stage {
            perspective: 900px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        /* Fixed Dark Matte & Liquid Glass Button */
        .liquid-coin {
            width: min(76vw, 310px);
            height: min(76vw, 310px);
            border-radius: 50%;
            position: relative;
            cursor: pointer;
            transform-style: preserve-3d;
            transform: rotateX(var(--coin-tilt-x)) rotateY(var(--coin-tilt-y)) scale(var(--coin-scale));
            transition: transform 0.14s cubic-bezier(0.22, 1, 0.36, 1);
            background: radial-gradient(circle at 32% 24%, #1c1c22 0%, #121216 42%, #0b0b0e 78%, #070709 100%);
            box-shadow:
                0 30px 65px -12px rgba(0, 0, 0, 0.96),
                0 0 38px -10px rgba(255, 255, 255, 0.05),
                inset 0 2px 3px rgba(255, 255, 255, 0.18),
                inset 0 -10px 24px rgba(0, 0, 0, 0.92);
            border: 1.5px solid rgba(255, 255, 255, 0.09);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        /* Concentric Inner Recessed Ring */
        .coin-inner-ring {
            width: 82%;
            height: 82%;
            border-radius: 50%;
            position: relative;
            background: radial-gradient(circle at 50% 38%, #151519 0%, #0a0a0d 76%, #060608 100%);
            border: 1px solid rgba(255, 255, 255, 0.06);
            box-shadow: 
                inset 0 8px 20px rgba(0, 0, 0, 0.9),
                inset 0 1px 1px rgba(255, 255, 255, 0.06),
                0 1px 2px rgba(255, 255, 255, 0.04);
        }

        /* Specular highlight gloss */
        .coin-gloss {
            position: absolute;
            top: 4%;
            left: 14%;
            width: 72%;
            height: 40%;
            border-radius: 50%;
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.09) 0%, rgba(255, 255, 255, 0) 100%);
            pointer-events: none;
            filter: blur(1px);
        }

        /* Dynamic Shine Spot that moves with finger tilt */
        .coin-dynamic-glare {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: radial-gradient(circle at var(--glare-x, 50%) var(--glare-y, 30%), rgba(255, 255, 255, 0.12) 0%, transparent 55%);
            pointer-events: none;
            opacity: 0.75;
        }

        /* Ripple Effect inside Coin */
        .tap-ripple {
            position: absolute;
            border-radius: 50%;
            transform: translate(-50%, -50%) scale(0);
            width: 240px;
            height: 240px;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.05) 45%, transparent 70%);
            pointer-events: none;
            animation: rippleExpand 0.55s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @keyframes rippleExpand {
            0% {
                transform: translate(-50%, -50%) scale(0.1);
                opacity: 0.85;
            }
            100% {
                transform: translate(-50%, -50%) scale(1.65);
                opacity: 0;
            }
        }

        /* Outer Shockwave Ring ( strictly neutral silver/white ) */
        .shockwave {
            position: fixed;
            border-radius: 50%;
            pointer-events: none;
            border: 1.5px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 0 18px rgba(255, 255, 255, 0.08);
            transform: translate(-50%, -50%) scale(0.8);
            animation: shockwaveAnim 0.65s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            z-index: 5;
        }

        @keyframes shockwaveAnim {
            0% {
                transform: translate(-50%, -50%) scale(0.85);
                opacity: 0.7;
            }
            100% {
                transform: translate(-50%, -50%) scale(1.36);
                opacity: 0;
            }
        }

        /* Floating +1 Number */
        .floating-plus {
            position: fixed;
            pointer-events: none;
            font-weight: 800;
            font-size: 1.75rem;
            letter-spacing: -0.03em;
            color: rgba(255, 255, 255, 0.9);
            text-shadow: 0 4px 16px rgba(0, 0, 0, 0.85);
            z-index: 30;
            transform: translate(-50%, -50%);
            animation: floatUp 0.82s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @keyframes floatUp {
            0% {
                opacity: 0;
                transform: translate(-50%, -30%) scale(0.6);
            }
            18% {
                opacity: 1;
                transform: translate(-50%, -65%) scale(1.05);
            }
            100% {
                opacity: 0;
                transform: translate(calc(-50% + var(--drift-x, 0px)), -165%) scale(0.92);
            }
        }

        /* Phrase Pill */
        .easter-pill {
            transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.3s ease;
        }
        .easter-pill.highlight {
            transform: scale(1.04);
            border-color: rgba(255, 255, 255, 0.24);
        }
    </style>
</head>
